generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id               Int             @id @default(autoincrement())
  name             String          @default("")
  email            String          @unique
  passwordHash     String          @map("password_hash")
  status           String          @default("active")
  roleId           Int             @map("role_id")
  role             Role            @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  offers           Offer[]         @relation("OfferOwner")
  applications     Application[]   @relation("ApplicantApplications")
  favorites        Favorite[]
  supportTickets   SupportTicket[]
  reportsSubmitted Report[]        @relation("ReportReporter")
  reportsAgainst   Report[]        @relation("ReportedUser")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Offer {
  id           Int           @id @default(autoincrement())
  externalId   String        @map("external_id")
  source       String
  title        String
  description  String
  companyName  String        @map("company_name")
  location     String
  contractType String        @map("contract_type")
  publishedAt  DateTime?     @map("published_at")
  salaryMin    Int?          @map("salary_min")
  salaryMax    Int?          @map("salary_max")
  remoteMode   String?       @map("remote_mode")
  status       String        @default("active")
  ownerId      Int?          @map("owner_id")
  owner        User?         @relation("OfferOwner", fields: [ownerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rawPayload   Json?         @map("raw_payload")
  applications Application[]
  favorites    Favorite[]
  reports      Report[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([source, externalId])
  @@index([location])
  @@index([contractType])
  @@index([publishedAt])
  @@index([status])
  @@index([ownerId])
  @@map("offers")
}

model IngestionRun {
  id             Int       @id @default(autoincrement())
  source         String
  status         String
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  offersFetched  Int       @default(0) @map("offers_fetched")
  offersInserted Int       @default(0) @map("offers_inserted")
  offersUpdated  Int       @default(0) @map("offers_updated")
  offersSkipped  Int       @default(0) @map("offers_skipped")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([source, status])
  @@index([startedAt])
  @@map("ingestion_runs")
}

model Application {
  id             Int      @id @default(autoincrement())
  offerId        Int      @map("offer_id")
  applicantId    Int      @map("applicant_id")
  status         String   @default("pending")
  candidateName  String   @map("candidate_name")
  candidateEmail String   @map("candidate_email")
  candidatePhone String?  @map("candidate_phone")
  coverLetter    String   @default("") @map("cover_letter")
  cv             String   @default("")
  aiInterview    Json?    @map("ai_interview")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  offer          Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  applicant      User     @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([offerId, applicantId])
  @@index([offerId, status])
  @@index([applicantId])
  @@map("applications")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  offerId   Int      @map("offer_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@map("favorites")
}

model SupportTicket {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  subject     String
  description String
  status      String    @default("open")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

model Report {
  id             Int      @id @default(autoincrement())
  type           String
  title          String?
  company        String?
  description    String?
  reason         String
  status         String   @default("pending")
  reporterUserId Int?     @map("reporter_user_id")
  reportedUserId Int?     @map("reported_user_id")
  offerId        Int?     @map("offer_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  reporterUser   User?    @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  offer          Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([type, status])
  @@index([offerId])
  @@index([reportedUserId])
  @@map("reports")
}
